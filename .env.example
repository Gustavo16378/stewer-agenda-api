# ---------------------------------------------------------------------
# Variaveis lidas pelo profile prod (padrao Railway).
# Em dev nada disso e necessario: o profile dev aponta pro docker-compose.
# ---------------------------------------------------------------------

# String JDBC do banco. No Railway costuma vir como DATABASE_URL no formato
# postgresql://user:pass@host:port/db -- converta para JDBC:
#   jdbc:postgresql://host:port/db
DATABASE_URL=jdbc:postgresql://localhost:5432/stewer_agenda
DATABASE_USERNAME=stewer
DATABASE_PASSWORD=stewer

# Segredo HMAC usado para assinar/validar o JWT (minimo 32 caracteres).
# Gere um novo: openssl rand -base64 48
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-de-no-minimo-32-chars

# Emissor gravado no claim "iss" e exigido na validacao.
JWT_ISSUER=https://stewer-agenda-api

# Validade do token em segundos (padrao: 8h)
JWT_EXPIRACAO_SEGUNDOS=28800

# Porta HTTP (o Railway injeta PORT automaticamente)
PORT=8080
